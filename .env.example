# Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
# (TOKEN=... also works, the name RazzBot uses.) No quotes around the value.
DISCORD_TOKEN=

# Optional. Normally you pick the channel in Discord with /setchannel. This is only a fallback for
# servers where /setchannel hasn't been used (right-click channel -> Copy Channel ID).
ANNOUNCE_CHANNEL_ID=

# Also post when someone switches to a new song (true/false). Default: only when they start listening.
ANNOUNCE_ON_TRACK_CHANGE=false

# Minutes before the same person can trigger another "started listening" post
COOLDOWN_MINUTES=1

# Branch pulled by !restart. Defaults to master.
UPDATE_BRANCH=master
