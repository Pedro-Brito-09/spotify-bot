[Unit]
Description=Spotify Listen Along Discord bot
After=network-online.target spotify-bot-update.service
Wants=network-online.target spotify-bot-update.service

[Service]
Type=simple
User=spotifybot
Group=spotifybot
WorkingDirectory=/opt/spotify-bot
EnvironmentFile=/etc/spotify-bot.env
Environment=npm_config_cache=/opt/spotify-bot/.npm
ExecStart=/usr/bin/node /opt/spotify-bot/src/index.js

Restart=always
RestartSec=10
# don't give up if Discord/network is down for a long stretch
StartLimitIntervalSec=0

# keep a small box from being eaten by a runaway process
MemoryMax=300M
MemoryHigh=200M

# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/opt/spotify-bot

StandardOutput=journal
StandardError=journal
SyslogIdentifier=spotify-bot

[Install]
WantedBy=multi-user.target
